{
  "name": "melcochat",
  "productName": "Melcochat",
  "version": "1.0.0-alpha.1",
  "description": "Every web app and AI chat you use, in one clean window — with true multi-account isolation.",
  "main": "out/main/index.js",
  "private": true,
  "license": "GPL-3.0",
  "author": "Melcochat contributors",
  "repository": { "type": "git", "url": "https://github.com/arielmitre20-prog/melco-chat.git" },
  "homepage": "https://github.com/arielmitre20-prog/melco-chat",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
